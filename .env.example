# Claude API credentials.
# Leave ANTHROPIC_API_KEY unset if you authenticate with `ant auth login` —
# the SDK resolves the stored profile automatically.
ANTHROPIC_API_KEY=

# Model routing. Orchestration and compliance run on the strongest model;
# the market analyst can be routed down for high-volume desks.
FINAGENT_MODEL=claude-opus-5
FINAGENT_ANALYST_MODEL=claude-opus-5
FINAGENT_EFFORT=high

# Governance
FINAGENT_MAX_REVISIONS=2
FINAGENT_AUDIT_DIR=./audit

# Synthetic market data is OPT-IN and never inherited from a default.
# The bundled fixture fabricates deterministic prices from a hash of the
# symbol; it is a test fixture, not a market simulator, and must never
# inform live advice. Set true only for demos against the sample mandates.
FINAGENT_ALLOW_SYNTHETIC_DATA=false
